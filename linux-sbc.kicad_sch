	(text_box "This project is a practice exercise in printed circuit board (PCB) design for a Linux-based single-board computer (SBC) intended for installation in an industrial environment.\n\nThe SBC integrates Bluetooth, Wi-Fi, and Ethernet connectivity to enable device control over wireless and network interfaces.\n\nThe design optionally supports an LCD display and a matrix keypad to allow local, physical control of the device.\n\nA USB hub expands the SBC's connectivity by providing four downstream USB ports.\n\nFor development and debugging purposes, the system includes a JTAG interface and a virtual COM port accessible through a USB-C connector.\n\nA microSD card interface is included to support booting the device from a portable Linux image."
		(exclude_from_sim no)
		(at 13.97 127 0)
		(size 186.69 87.63)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -0.0001)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "7b7a2424-88f0-40c5-9e37-d7b18c25e692")
	)
