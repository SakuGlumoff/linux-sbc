	(text "Route uSD as\n50 Ω single-ended."
		(exclude_from_sim no)
		(at 86.36 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 194 0 194 1)
			)
			(justify right bottom)
		)
		(uuid "705c0748-c15c-4533-a41b-033ecf9c8794")
	)
	(text_box "micro-SD card interface provides the option to provide the operating system image on the SD card and to boot from it.\n- The micro-SD card interface is human-interactable and thus has ESD TVS diodes for protection.\n- The micro-SD card interface is a push-push type and includes insertion detection capability. The insertion detection on the MPU side is active LOW.\n    - When the SD card is not inserted, the DET_A and DET_B pins are disconnected.\n    - When the SD card is connected, the DET_A and DET_B pins are connected."
		(exclude_from_sim no)
		(at 13.97 63.5 0)
		(size 391.16 25.4)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -0.0001)
			(type solid)
		)
		(fill
