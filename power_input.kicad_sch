				(size 2 2)
			)
			(justify left top)
		)
		(uuid "bd8ce0b3-c89e-48ef-aa51-f821f9749ecf")
	)
	(text_box "Target cutoff @ 100 kHz with -60 dB @ 2.4 MHz\n\nI_{TRANSIENT_MAX} = 1.5 A\nV_{TRANSIENT_MAX} = 0.05 V\nC_{BULK_TOTAL_MIN} = (1.21 * I_{TRANSIENT_MAX}^{2} * L) / V_{TRANSIENT_MAX}^{2} ~= 512 uF"
