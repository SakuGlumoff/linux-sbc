		(uuid "bd8ce0b3-c89e-48ef-aa51-f821f9749ecf")
	)
	(text_box "Target cutoff @ 100 kHz with -60 dB @ 2 MHz (SMPS frequency).\n\nI_{TRANSIENT_MAX} = 2.5 A\nV_{TRANSIENT_MAX} = 0.05 V\nC_{BULK_TOTAL_MIN} = (1.21 * I_{TRANSIENT_MAX}^{2} * L) / V_{TRANSIENT_MAX}^{2} ~= 1422 uF"
		(exclude_from_sim no)
