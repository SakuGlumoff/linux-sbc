	(text_box "OCLO_OUT_N = I_{IN} * R_{S} * (R_{F} / R_{G}) -> @ 0.1 A = 0.5 V, @ 1 A = 5 V\nV_{CM} = 24 V * (R_{F} / (R_{G} + R_{F})) ~= 23.53 V\nP_{Rs} = 0.1 * 1 A * 1 A = 0.1 W\nV_{TRIGGER} = 5V, V_{HYST} = 0.5 V, R2/R1 ratio @ 24 V = 48000.\nR1 = 1 k, R2 = 100 k -> V_TH_{H} = 5.05 V, V_TH_{L} = 4.81 V"
		(exclude_from_sim no)
		(at 242.57 48.26 0)
		(size 162.56 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
