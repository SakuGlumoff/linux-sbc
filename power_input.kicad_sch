	(text_box "OVLO_OUT @ 26.4 V ~= 0 V, @ 26.5 V ~= 26.5V\nHysteresis: TBD"
		(exclude_from_sim no)
		(at 255.27 48.26 0)
		(size 100.33 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
