	)
	(text_box "OCLO_IN = I_{IN} * R_{S} * (R_{F} / R_{G}) -> @ 0.1 A = 0.25 V, @ 2 A = 5 V\nR_{s} power dissipation = 0.05 * 2 A * 2 A = 0.2 W\nHysteresis: TBD"
		(exclude_from_sim no)
		(at 140.97 149.86 0)
		(size 125.73 15.24)
