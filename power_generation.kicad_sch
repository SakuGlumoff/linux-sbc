			(justify top)
		)
		(uuid "8ce42b62-a9e5-43f7-b17e-edb2edc66bd5")
	)
	(text_box "R_{RT} @ 1000 kHz = 100000 / f_{SW[kHz]} = 100 kΩ\nR_{FBT} = R_{FBB} * ((V_{OUT} / 0.8 V) - 1) = 68 kΩ * ((3.3 V / 0.8 V) - 1) = 212.5 kΩ\nR_{COMP} = 4.67*10^{3}[Ω/A] * f_{c} * V_{OUT} * C_{OUT} = 4.67*10^{3}[Ω/A] * 15 kHz * 5 V * 100 µF ~= 23.1 kΩ\nC_{COMP} = (V_{OUT} * C_{OUT}) / (I_{OUT} * R_{COMP}) = (5 V * 100 µF) / (4.5 A * 35 kΩ) ~= 3571 pF\n\nL = (V_{OUT} * (V_{IN_MAX} - V_{OUT})) / (V_{IN_MAX} * ∆I_{L} * f_{SW}) = (3.3 V * (24 V - 3.3 V)) / (24 V * (4 A * 30 %) * 1000 kHz) ~= 2.37 µH\nI_{L_PEAK} = I_{LOAD} + (∆I_{L} / 2) ~= 6.5 A"
		(exclude_from_sim no)
		(at 13.97 156.21 0)
		(size 187.96 34.29)
